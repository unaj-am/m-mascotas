{
  "name": "m-mascotas",
  "version": "0.1.0",
  "private": true,
  "main": "./src/main.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:usb": "expo start --dev-client --localhost --android --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist/web",
    "start:tunnel": "expo start --dev-client --tunnel ngrok"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "firebase": "^13.1.0",
    "inversify": "7.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
